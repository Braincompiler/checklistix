    "serve:ssr:checklistix": "node dist/checklistix/server/server.mjs",
    "openapi:generate": "openapi-generator-cli generate",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > functions/db.types.ts"
  },
  "private": true,
  "type": "module",
  "dependencies": {
