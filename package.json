{
  "name": "checklistix",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=4321",
    "netlify-dev": "netlify dev",
    "build": "npm run openapi:generate && ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
