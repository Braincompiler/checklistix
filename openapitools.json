{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 4,
  "generator-cli": {
    "version": "7.6.0",
    "generators": {
      "checklistixDataApiClient": {
        "generatorName": "typescript-angular",
        "inputSpec": "./openapi/checklistix-data.yaml",
        "output": "./src/api/data",
        "additionalProperties": {
          "fileNaming": "kebab-case"
        }
      },
      "checklistixAuthApiClient": {
        "generatorName": "typescript-angular",
        "inputSpec": "./openapi/checklistix-auth.yaml",
        "output": "./src/api/auth",
        "additionalProperties": {
          "fileNaming": "kebab-case"
        }
      }
    }
  }
}
