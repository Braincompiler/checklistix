{
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "editorconfig": true,
  "endOfLine": "lf",
  "printWidth": 160,
  "quoteProps": "consistent",
  "semi": true,
  "singleAttributePerLine": true,
  "singleQuote": true,
  "tabWidth": 4,
  "useTabs": false,
  "trailingComma": "all",
  "overrides": [
    {
      "files": [
        "*.json",
        ".prettierrc"
      ],
      "options": {
        "tabWidth": 2
      }
    }
  ],
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "^@angular/(.*)$",
    "^rxjs(/.*)?$",
    "^primeng",
    "<THIRD_PARTY_MODULES>",
    "^@(components|services|pipes|directives|api)",
    "^[../]",
    "^[./]"
  ],
  "importOrderParserPlugins": [
    "typescript",
    "classProperties",
    "decorators-legacy"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderCaseInsensitive": true
}
